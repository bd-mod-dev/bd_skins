module Base
{
    model Tatra815_BumperFront
	{
		mesh = vehicles/Vehicles_Tatra815_Body|frontprotection,
		shader = vehicle,
		scale = 1,
	}


    template vehicle Tatra815_bumpers_Watermelon
    {
	template = ATA2Bumpers/part/ATA2Bumper,
        part ATA2Bumper
        {
            area = Engine,
            
        }


        part ATA2Bumper*
        {
            table install
            {
                test = ATATuning2.InstallTest.Tuning,
                complete = ATATuning2.InstallComplete.Tuning,
            }

            table uninstall
            {
                test = ATATuning2.UninstallTest.Tuning,
                complete = ATATuning2.UninstallComplete.Tuning,
            }

            lua
            {
                create = ATATuning2.Create.Tuning,
                init = ATATuning2.Init.Tuning,
                update = ATATuning2.Update.Protection,
            }
        }
    }
}